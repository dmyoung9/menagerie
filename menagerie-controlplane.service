[Unit]
Description=Menagerie local inference control plane
After=network.target
Conflicts=llama-shelf.service llama-router.service llama-gemma4.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/menagerie
ExecStart=%h/Projects/menagerie/.venv/bin/python -m controlplane
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/menagerie
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
