[Unit]
Description=Menagerie reviewed shelf apply/recovery %i

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/menagerie
ExecStart=/usr/bin/python3 %h/Projects/menagerie/config_control.py apply %i
ExecStopPost=/usr/bin/python3 %h/Projects/menagerie/config_control.py recover %i
TimeoutStartSec=300
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/menagerie %h/ai/qwen38-trials
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
